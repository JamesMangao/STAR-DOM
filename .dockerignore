# packages/ is intentionally NOT excluded: it carries the vendored Npgsql.dll
# plus System.Memory / System.Runtime.CompilerServices.Unsafe /
# System.Threading.Tasks.Extensions, and the Dockerfile builds with msbuild
# without a package restore step. Excluding it makes the build fail.
.git
.vs
bin/
obj/
*.user
*.suo
~$*

# Local-only tooling and data: the portable PostgreSQL used for development
# (the deployed app talks to Supabase, never to this instance) and its data dir.
tools/pgsql
tools/pgdata
