<%@ Master Language="VB" CodeBehind="Site.master.vb" Inherits="STAR_DOM.Web.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>STAR:DOM — Artisan &amp; Pop-up Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,500..700,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/site.css?v=20261001" />
    <link rel="icon" type="image/webp" href="/Assets/stardom-logo.webp" />
    <link rel="apple-touch-icon" href="/Assets/stardom-logo.webp" />
</head>
<body>
    <form id="shell" runat="server" autocomplete="off">
    <%-- CSRF token for every POST on the site. Lives in the shell form so all
         page-rendered forms post it back; verified in Global.asax.vb. --%>
    <%= STAR_DOM.Web.Csrf.HiddenField() %>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" id="brandLink" runat="server" href="/">
                <img class="brand-img" src="/Assets/stardom-logo.webp" alt="STAR:DOM logo" />
                <span class="brand-txt">
                    <span class="brand-logo">STAR:DOM<span class="brand-dot"></span></span>
                    <span class="brand-sub">ARTISAN &amp; POP-UP HUB</span>
                </span>
            </a>
            <div class="searchbox">
                <input type="text" id="topSearchInput" name="q" placeholder="Search products, artists, pop-up venues..." onkeydown="if(event.key==='Enter'||event.keyCode===13){event.preventDefault();var val=this.value.trim();if(val){window.location.href='/App/Catalog.aspx?q='+encodeURIComponent(val);}}" />
                <button type="button" aria-label="Search" onclick="var inp=document.getElementById('topSearchInput');var val=inp?inp.value.trim():'';if(val){window.location.href='/App/Catalog.aspx?q='+encodeURIComponent(val);}"><span class="ms sm">search</span></button>
            </div>
            <div class="top-right">
                <asp:PlaceHolder ID="livePillPh" runat="server" />
                <span class="currency-chip">PHP (₱)</span>
                <a class="icon-btn" id="cartBtn" runat="server" href="/App/Cart.aspx" title="Cart">
                    <span class="ms">shopping_bag</span><asp:Literal ID="cartCount" runat="server" />
                </a>
                <a class="icon-btn" id="notifBtn" runat="server" href="/App/Notifications.aspx" title="Notifications">
                    <span class="ms">notifications</span><asp:Literal ID="notifCount" runat="server" />
                </a>
                <asp:PlaceHolder ID="userPh" runat="server" />
            </div>
        </div>
    </header>

    <asp:PlaceHolder ID="bannerPh" runat="server" />

    <div class="layout">
        <aside class="sidebar">
            <asp:Literal ID="navLiteral" runat="server" />
        </aside>
        <main class="main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>
    </div>

    <footer class="foot">
        <div class="foot-inner">
            <div>
                <div style="display:flex;align-items:center;gap:10px">
                    <img src="/Assets/stardom-logo.webp" alt="" class="brand-img" style="height:26px" />
                    <div class="brand-logo" style="font-size:17px">STAR:DOM<span class="brand-dot"></span></div>
                </div>
                <span class="pill small yellow" style="margin-top:6px">PH MARKETPLACE</span>
                <p>The premier Filipino artisan hub connecting independent creators with art lovers through online ordering and nationwide delivery.</p>
                <span style="font-size:11px;letter-spacing:.1em;font-weight:800;color:var(--ink-soft)">MERCHANT INQUIRY HOTLINE</span><br />
                <b style="font-family:var(--font-mono);color:var(--primary);font-size:14px">+63 (02) 8839-4421</b>
            </div>
            <div>
                <h4>POP-UP TOUR 2026</h4>
                <ul>
                    <asp:Literal ID="footerTourLinks" runat="server" />
                </ul>
            </div>
            <div>
                <h4>PAYMENTS &amp; PLATFORM</h4>
                <p>Trusted nationwide shipping with cashless checkout.</p>
                <div class="pay-chips">
                    <span class="pay-chip">GCash</span>
                    <span class="pay-chip">Maya</span>
                    <span class="pay-chip">J&amp;T Express</span>
                </div>
                <ul style="margin-top:14px">
                    <li><a href="/App/Catalog.aspx">Products Catalog</a></li>
                    <li><a href="/App/CommissionHub.aspx">Commission Hub</a></li>
                    <li><a href="/App/Orders.aspx">My Orders / Wishlist</a></li>
                    <li><a href="/Register.aspx">Open an Account</a></li>
                </ul>
            </div>
            <div>
                <h4>ARTISAN STUDIO</h4>
                <p>STAR:DOM is a solo-artist brand — every product is personally handcrafted with love.</p>
                <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:10px">
                    <a class="btn ghost" href="/App/CommissionHub.aspx" style="font-size:12px"><span class="ic ms">brush</span> Commission</a>
                    <a class="btn ghost" href="/App/Catalog.aspx" style="font-size:12px"><span class="ic ms">inventory_2</span> Full Catalog</a>
                </div>
            </div>
        </div>
        <div class="foot-bar">© 2026 STAR:DOM Artisan &amp; Pop-up Hub · Atelier Dispatch Engine v4.8 · VB.NET Web Forms &middot; <a href="/App/PopupLocations.aspx" style="font-weight:700">View Tour Map</a></div>
    </footer>
    </form>

    <!-- STAR:DOM confirm modal -->
    <div class="modal-backdrop" id="appModal" aria-hidden="true">
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="appModalTitle" aria-describedby="appModalMsg">
            <span class="modal-ic ms" id="appModalIcon">help</span>
            <h3 id="appModalTitle">Are you sure?</h3>
            <p class="modal-msg" id="appModalMsg"></p>
            <div class="modal-actions">
                <button type="button" class="btn ghost" id="appModalCancel">Cancel</button>
                <button type="button" class="btn primary" id="appModalOK">Confirm</button>
            </div>
        </div>
    </div>

    <!-- STAR:DOM quantity picker. Any element with data-addcart opens this instead
         of navigating straight to Cart.aspx with q=1; the real href stays on the
         anchor as the no-JavaScript / anonymous-sign-in fallback. -->
    <div class="modal-backdrop" id="qtyModal" aria-hidden="true">
        <div class="modal-card qty-card" role="dialog" aria-modal="true" aria-labelledby="qtyModalTitle" aria-describedby="qtyNote">
            <span class="ag-ribbon" aria-hidden="true"></span>
            <button type="button" class="ag-x" id="qtyX" aria-label="Close"><span class="ms sm">close</span></button>
            <span class="modal-ic ag-ic ms">shopping_basket</span>
            <span class="ag-eyebrow">Choose quantity</span>
            <h3 id="qtyModalTitle">Add to cart</h3>
            <div class="ag-product" id="qtyProduct">
                <span class="ag-thumb" id="qtyThumb"></span>
                <span class="ag-pmeta"><b id="qtyName"></b><span id="qtyUnit"></span></span>
            </div>
            <div class="qty-row">
                <button type="button" class="qty-step" id="qtyMinus" aria-label="Decrease quantity"><span class="ms sm">remove</span></button>
                <input type="number" id="qtyInput" value="1" min="1" step="1" inputmode="numeric" autocomplete="off" aria-label="Quantity to add" />
                <button type="button" class="qty-step" id="qtyPlus" aria-label="Increase quantity"><span class="ms sm">add</span></button>
            </div>
            <p class="modal-msg qty-note" id="qtyNote"></p>
            <div class="qty-total"><span>Subtotal</span><b id="qtyTotal">&mdash;</b></div>
            <div class="modal-actions qty-actions">
                <button type="button" class="btn ghost" id="qtyCancel">Cancel</button>
                <button type="button" class="btn primary" id="qtyAdd">Add to cart</button>
            </div>
        </div>
    </div>

    <!-- STAR:DOM premium sign-in gate. Rendered only for anonymous visitors
         (Site.master.vb sets Visible); when it is absent the script below treats
         the whole gate as inert, so signed-in users never see it. -->
    <div class="modal-backdrop" id="authGate" runat="server" visible="false" aria-hidden="true">
        <div class="modal-card auth-gate" role="dialog" aria-modal="true" aria-labelledby="authGateTitle" aria-describedby="authGateMsg">
            <span class="ag-ribbon" aria-hidden="true"></span>
            <button type="button" class="ag-x" id="authGateX" aria-label="Close"><span class="ms sm">close</span></button>
            <span class="modal-ic ag-ic ms">lock</span>
            <span class="ag-eyebrow">Sign in required</span>
            <h3 id="authGateTitle">Almost there</h3>
            <p class="modal-msg" id="authGateMsg">Browsing is open to everyone. Your cart, orders, and commission requests live inside your account.</p>
            <div class="ag-product" id="authGateProduct" style="display:none">
                <span class="ag-thumb" id="authGateThumb"></span>
                <span class="ag-pmeta"><b id="authGateName"></b><span id="authGatePrice"></span></span>
            </div>
            <ul class="ag-benefits">
                <li><span class="ms sm">check_circle</span> Check out in seconds with GCash, Maya, or COD</li>
                <li><span class="ms sm">check_circle</span> Follow nationwide delivery with live J&amp;T status</li>
                <li><span class="ms sm">check_circle</span> Keep your wishlist and commissions in one place</li>
            </ul>
            <div class="modal-actions ag-actions">
                <a class="btn primary" id="authGateSignIn" href="/Login.aspx">Sign In</a>
                <a class="btn ghost" id="authGateRegister" href="/Register.aspx">Create free account</a>
            </div>
            <button type="button" class="ag-skip" id="authGateSkip">Continue browsing</button>
        </div>
    </div>

    <!-- Page route progress indicator -->
    <div id="page-progress"></div>

    <!-- Toast popup: rendered by Site.master.vb when a page signals a flash
         event via ?added=1&cartN=<n> (Cart.aspx add-to-cart redirect). Pure
         CSS animation; the inline script only removes it and cleans the URL. -->
    <div class="toast-wrap" id="toastWrap" runat="server"></div>

    <script>
    (function () {
        // ---------- Premium sign-in gate ----------
        // Present only when the master rendered it, i.e. only for anonymous
        // visitors. When it is null every function below is inert, so a signed-in
        // shopper is never intercepted.
        var gate = document.getElementById('authGate');
        var gateCard = gate ? gate.querySelector('.auth-gate') : null;
        var gateSignIn = document.getElementById('authGateSignIn');
        var gateRegister = document.getElementById('authGateRegister');
        var gateProduct = document.getElementById('authGateProduct');
        var gateThumb = document.getElementById('authGateThumb');
        var gateName = document.getElementById('authGateName');
        var gatePrice = document.getElementById('authGatePrice');
        var gateSkip = document.getElementById('authGateSkip');
        var gateX = document.getElementById('authGateX');
        var gateLastFocus = null;

        // Mirrors the Guard.Require* set in the page code. Kept as a list so a new
        // account-only page is one entry away from being covered.
        var GATED = [
            '/app/cart.aspx',
            '/app/checkout.aspx',
            '/app/orders.aspx',
            '/app/orderdetail.aspx',
            '/app/notifications.aspx',
            '/app/profile.aspx',
            '/app/receipt.aspx',
            '/app/commissionhub.aspx',
            '/app/commissionrequest.aspx',
            '/app/commissiondetail.aspx',
            '/app/merchant/',
            '/app/admin/'
        ];

        function isGated(el) {
            if (!gate) return false;
            if (el.hasAttribute('data-auth-gate')) return true;
            var path = (el.pathname || '').toLowerCase();
            if (!path) return false;
            for (var i = 0; i < GATED.length; i++) {
                if (path.indexOf(GATED[i]) === 0) return true;
            }
            return false;
        }

        // Product images are stored as rooted, same-origin file paths, but they can
        // contain spaces, so the guard only rejects what could break out of the
        // quoted url() or reach off-origin.
        function safeImg(v) {
            if (!v) return '';
            v = v.trim();
            if (v.charAt(0) !== '/') return '';
            if (/["'\\<>]/.test(v)) return '';
            if (/^[/\\]{2}/.test(v)) return '';
            return v;
        }

        function paintThumb(el, name, img, seed) {
            if (!el) return;
            el.style.backgroundImage = '';
            var imgSafe = safeImg(img);
            if (imgSafe) {
                el.style.backgroundImage = "url('" + imgSafe + "')";
                el.classList.add('has-img');
                el.textContent = '';
                return;
            }
            el.classList.remove('has-img');
            var hue = (parseInt(seed, 10) || 0) * 47 % 360;
            el.style.background = 'linear-gradient(135deg, hsl(' + hue + ',72%,93%), hsl(' +
                ((hue + 40) % 360) + ',66%,85%))';
            var parts = (name || '').trim().split(/\s+/);
            var letters = '';
            for (var i = 0; i < Math.min(parts.length, 2); i++) {
                if (parts[i]) letters += parts[i].charAt(0);
            }
            el.textContent = letters.toUpperCase() || 'SD';
        }

        function openGate(link) {
            var href = link.getAttribute('href') || '';
            var r = encodeURIComponent(href);
            // Both CTAs carry the clicked link as the return target, so signing in
            // (or registering) completes exactly what the visitor asked for.
            gateSignIn.href = '/Login.aspx?r=' + r;
            gateRegister.href = '/Register.aspx?r=' + r;

            var name = link.getAttribute('data-name');
            if (name) {
                gateName.textContent = name;
                gatePrice.textContent = link.getAttribute('data-price') || '';
                paintThumb(gateThumb, name, link.getAttribute('data-img'), link.getAttribute('data-seed'));
                gateProduct.style.display = 'flex';
            } else {
                gateProduct.style.display = 'none';
            }

            gateLastFocus = link;
            gate.classList.add('open');
            gate.setAttribute('aria-hidden', 'false');
            gateCard.classList.remove('pop');
            void gateCard.offsetWidth;
            gateCard.classList.add('pop');
            gateSignIn.focus();
        }

        function closeGate() {
            if (!gate) return;
            if (!gate.classList.contains('open')) return;
            gate.classList.remove('open');
            gate.setAttribute('aria-hidden', 'true');
            if (gateLastFocus) gateLastFocus.focus();
        }

        document.addEventListener('click', function (e) {
            var link = e.target && e.target.closest ? e.target.closest('a') : null;
            if (!link || !link.href || !isGated(link)) return;
            e.preventDefault();
            openGate(link);
        });

        if (gate) {
            gateSkip.addEventListener('click', closeGate);
            gateX.addEventListener('click', closeGate);
            gate.addEventListener('click', function (e) {
                if (e.target === gate) closeGate();
            });
            document.addEventListener('keydown', function (e) {
                if (!gate.classList.contains('open')) return;
                if (e.key === 'Escape') closeGate();
            });
        }

        // ---------- Quantity picker (add to cart) ----------
        // Every data-addcart link opens this instead of jumping to Cart.aspx
        // with q=1. The anchor's href is still a complete, working add, so this
        // is an enhancement: without JS, or for the anonymous sign-in gate,
        // the raw link still adds one.
        var qtyModal = document.getElementById('qtyModal');
        var qtyCard = qtyModal ? qtyModal.querySelector('.qty-card') : null;
        var qtyThumb = document.getElementById('qtyThumb');
        var qtyInput = document.getElementById('qtyInput');
        var qtyNote = document.getElementById('qtyNote');
        var qtyTotal = document.getElementById('qtyTotal');
        var qtyMinus = document.getElementById('qtyMinus');
        var qtyPlus = document.getElementById('qtyPlus');
        var qtyAdd = document.getElementById('qtyAdd');
        var qtyTarget = null;
        var qtyUnit = 0;
        var qtyMax = 1;
        var qtyOut = false;
        var qtyLastFocus = null;

        function peso(n) {
            return '₱' + Number(n).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function qtyClamp(v) {
            var n = parseInt(v, 10);
            if (!isFinite(n) || n < 1) n = 1;
            if (n > qtyMax) n = qtyMax;
            return n;
        }

        function qtySync(fromTyping) {
            var n = qtyClamp(qtyInput.value);
            if (!fromTyping) qtyInput.value = n;
            qtyInput.disabled = qtyOut;
            qtyAdd.disabled = qtyOut;
            qtyMinus.disabled = qtyOut || n <= 1;
            qtyPlus.disabled = qtyOut || n >= qtyMax;
            if (qtyOut) {
                // Active but zero-stock items still render an Add button, so say
                // why instead of letting the shopper fill in a doomed quantity.
                qtyNote.textContent = 'This one is out of stock right now.';
                qtyTotal.textContent = '—';
                return n;
            }
            qtyTotal.textContent = peso(qtyUnit * n);
            // Only nag about the ceiling once it is a real ceiling, and only once
            // the shopper has actually pushed against it.
            if (qtyMax > 1 && n >= qtyMax) {
                qtyNote.textContent = 'That is all we have in the booth right now.';
            } else {
                qtyNote.textContent = '';
            }
            return n;
        }

        function openQty(link) {
            qtyTarget = link.getAttribute('data-addcart') || link.getAttribute('href') || '';
            qtyUnit = parseFloat(link.getAttribute('data-unit'));
            if (!isFinite(qtyUnit) || qtyUnit < 0) qtyUnit = 0;
            var stock = parseInt(link.getAttribute('data-stock'), 10);
            qtyOut = !isFinite(stock) || stock <= 0;
            qtyMax = qtyOut ? 1 : stock;

            var name = link.getAttribute('data-name') || 'this item';
            document.getElementById('qtyName').textContent = name;
            document.getElementById('qtyUnit').textContent = link.getAttribute('data-price') || '';
            paintThumb(qtyThumb, name, link.getAttribute('data-img'), link.getAttribute('data-seed'));

            qtyInput.max = qtyMax;
            qtyInput.value = 1;
            qtySync(false);

            qtyLastFocus = link;
            qtyModal.classList.add('open');
            qtyModal.setAttribute('aria-hidden', 'false');
            qtyCard.classList.remove('pop');
            void qtyCard.offsetWidth;
            qtyCard.classList.add('pop');
            // The input is disabled for out-of-stock items, so park focus on
            // Cancel rather than leaving keyboard users outside the dialog.
            (qtyOut ? document.getElementById('qtyCancel') : qtyInput).focus();
            if (!qtyOut) qtyInput.select();
        }

        function closeQty() {
            if (!qtyModal.classList.contains('open')) return;
            qtyModal.classList.remove('open');
            qtyModal.setAttribute('aria-hidden', 'true');
            if (qtyLastFocus) qtyLastFocus.focus();
        }

        function submitQty() {
            if (!qtyTarget || qtyOut) return;
            var n = qtySync(false);
            // Swap only the q= value, so ret= and anything else the caller
            // supplied survive untouched. The href always ships a q, but the
            // fallback keeps this honest if a call site ever drops it.
            var url = qtyTarget.replace(/([?&])q=[^&]*/, '$1q=' + n);
            if (!/[?&]q=\d+/.test(url)) {
                url += (url.indexOf('?') >= 0 ? '&' : '?') + 'q=' + n;
            }
            closeQty();
            if (bar) bar.className = 'loading';
            document.body.classList.add('page-leaving');
            setTimeout(function () { window.location.href = url; }, 140);
        }

        if (qtyModal) {
            qtyMinus.addEventListener('click', function () { qtyInput.value = qtyClamp((parseInt(qtyInput.value, 10) || 1) - 1); qtySync(false); });
            qtyPlus.addEventListener('click', function () { qtyInput.value = qtyClamp((parseInt(qtyInput.value, 10) || 1) + 1); qtySync(false); });
            qtyInput.addEventListener('input', function () { qtySync(true); });
            qtyInput.addEventListener('blur', function () { qtySync(false); });
            qtyAdd.addEventListener('click', submitQty);
            document.getElementById('qtyCancel').addEventListener('click', closeQty);
            document.getElementById('qtyX').addEventListener('click', closeQty);
            qtyModal.addEventListener('click', function (e) { if (e.target === qtyModal) closeQty(); });
            document.addEventListener('keydown', function (e) {
                if (!qtyModal.classList.contains('open')) return;
                if (e.key === 'Escape') closeQty();
                else if (e.key === 'Enter' && e.target === qtyInput) { e.preventDefault(); submitQty(); }
            });
        }

        document.addEventListener('click', function (e) {
            var link = e.target && e.target.closest ? e.target.closest('[data-addcart]') : null;
            if (!link) return;
            // Anonymous shoppers get the sign-in gate instead; the gate carries
            // this href to Login.aspx so the Add still completes on the way back.
            if (isGated(link)) return;
            // New tab / new window: let the browser use the plain href.
            if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey || e.button !== 0) return;
            e.preventDefault();
            openQty(link);
        });

        // Page transition exit animation & progress bar
        var bar = document.getElementById('page-progress');
        document.addEventListener('click', function (e) {
            var link = e.target && e.target.closest ? e.target.closest('a') : null;
            if (!link || !link.href) return;
            if (link.target === '_blank' || link.hasAttribute('download') || link.getAttribute('data-confirm')) return;
            if (link.hasAttribute('data-addcart')) return;
            if (isGated(link)) return;
            if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey || e.button !== 0) return;

            var url;
            try { url = new URL(link.href, window.location.href); } catch (err) { return; }
            if (url.origin !== window.location.origin) return;
            if (url.pathname === window.location.pathname && url.search === window.location.search && url.hash) return;
            if (link.getAttribute('href').indexOf('javascript:') === 0 || link.getAttribute('href') === '#') return;

            e.preventDefault();
            if (bar) bar.className = 'loading';
            document.body.classList.add('page-leaving');
            setTimeout(function () {
                window.location.href = link.href;
            }, 140);
        });

        window.addEventListener('pageshow', function (e) {
            document.body.classList.remove('page-leaving');
            if (bar) {
                bar.className = 'done';
                setTimeout(function () { bar.className = ''; }, 300);
            }
        });

        // App modal logic
        var backdrop = document.getElementById('appModal');
        var card = backdrop.querySelector('.modal-card');
        var title = document.getElementById('appModalTitle');
        var okBtn = document.getElementById('appModalOK');
        var cancelBtn = document.getElementById('appModalCancel');
        var icon = document.getElementById('appModalIcon');
        var lastFocus = null;
        var pending = null;

        function open(text, opts) {
            opts = opts || {};
            document.getElementById('appModalMsg').textContent = text;
            title.textContent = opts.title || 'Are you sure?';
            okBtn.textContent = opts.okText || 'Confirm';
            icon.textContent = opts.danger ? 'warning' : 'help';
            okBtn.className = 'btn ' + (opts.danger ? 'danger' : 'primary');
            card.className = 'modal-card' + (opts.danger ? ' danger' : '');
            backdrop.classList.add('open');
            backdrop.setAttribute('aria-hidden', 'false');
            cancelBtn.focus();
        }

        function close() {
            if (!backdrop.classList.contains('open')) return;
            backdrop.classList.remove('open');
            backdrop.setAttribute('aria-hidden', 'true');
            if (lastFocus) lastFocus.focus();
        }

        function confirm() {
            var go = pending;
            pending = null;
            close();
            if (go) go();
        }

        cancelBtn.addEventListener('click', close);
        okBtn.addEventListener('click', confirm);
        backdrop.addEventListener('click', function (e) {
            if (e.target === backdrop) close();
        });
        document.addEventListener('keydown', function (e) {
            if (!backdrop.classList.contains('open')) return;
            if (e.key === 'Escape') close();
            else if (e.key === 'Enter' && !(e.target && e.target.tagName === 'BUTTON')) confirm();
        });

        document.addEventListener('click', function (e) {
            var el = e.target && e.target.closest ? e.target.closest('[data-confirm]') : null;
            if (!el || el.disabled) return;
            e.preventDefault();
            lastFocus = el;
            var msg = el.getAttribute('data-confirm');
            pending = function () {
                var tag = el.tagName.toLowerCase();
                if (tag === 'a') {
                    if (bar) bar.className = 'loading';
                    document.body.classList.add('page-leaving');
                    setTimeout(function() { window.location.href = el.href; }, 140);
                    return;
                }
                var saved = msg;
                el.removeAttribute('data-confirm');
                try { el.click(); } finally { if (saved) el.setAttribute('data-confirm', saved); }
            };
            open(msg, { danger: el.hasAttribute('data-confirm-danger'), okText: el.getAttribute('data-confirm-ok') });
        });
    })();
    </script>
</body>
</html>
