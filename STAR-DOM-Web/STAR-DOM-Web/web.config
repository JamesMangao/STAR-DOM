<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <!-- STAR:DOM database (XAMPP MySQL, root has no password). Change to match your server.
         This value is only the local-dev fallback: Code\Db.vb prefers the MYSQL_URL /
         DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD / DB_SSLMODE environment
         variables when they are set, so a deployed host supplies the real credentials
         from its environment and never needs a password committed to source control.

         NOTE: Code\Db.vb still uses MySql.Data/MySqlConnection, so this must stay a
         MySQL connection string until the Npgsql port is finished. -->
    <add name="STAR_DOM"
         connectionString="Server=localhost;Port=3306;Database=stardom;User Id=root;Password=;SslMode=none;AllowPublicKeyRetrieval=True;CharSet=utf8mb4;Convert Zero Datetime=True;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="AppName" value="STAR:DOM Artisan &amp; Pop-up Hub" />
    <add key="CurrencySymbol" value="₱" />
    <add key="LowStockThreshold" value="5" />
    <add key="Receipt.RegisteredName" value="STAR:DOM Artisan Marketplace &amp; Pop-up Tour" />
    <add key="Receipt.IssuerTin" value="000-000-000-000" />
    <add key="Receipt.IssuerAddress" value="Unit 12, South Luzon Atelier, Santa Rosa, Laguna" />
    <add key="Receipt.AccreditationNo" value="PTU-2026-00015" />
    <add key="Receipt.LineOfBusiness" value="On-line selling of artisan goods &amp; commission services" />

    <!-- Supabase: the publishable/secret keys that used to live here were removed.
         They are credentials and must never be committed to source control, and no
         code reads them today (the port is still on MySql.Data). When the Supabase
         / Npgsql port is done, read them from the environment instead, the same way
         Code\Db.vb already does for the database:
             Environment.GetEnvironmentVariable("SUPABASE_URL")
             Environment.GetEnvironmentVariable("SUPABASE_PUBLISHABLE_KEY")
             Environment.GetEnvironmentVariable("SUPABASE_SECRET_KEY")
         Set them in the host's environment (Render dashboard, IIS app pool, or
         user-level env var) and reference them from code. -->
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" requestValidationMode="2.0" />
    <!-- InProc session holds the signed-in user, so it dies when the app pool recycles.
         That's the one thing to revisit before scaling past a single machine. -->
    <sessionState mode="InProc" timeout="120" />
    <!-- Show the friendly Error.aspx page (which reads the message Global.asax stored
         in Session) instead of leaking stack traces. Detailed errors are still written
         to the AppErrors table by Code\Db.vb.LogError.
         Set customErrors="Off" temporarily while debugging, never on a public host. -->
    <customErrors mode="RemoteOnly" />
    <pages controlRenderingCompatibilityVersion="4.0" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <!-- Session cookie holds the logged-in user: keep it out of reach of page scripts.
         sameSite is deliberately omitted: it is a .NET 4.7.2+ attribute and the
         Linux/Mono (xsp4) deploy in Dockerfile may reject the whole config on it.
         requireSSL is false only because local dev runs on http://localhost — set it
         to true once the site is served over HTTPS. -->
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="App/Marketplace.aspx" />
        <add value="Login.aspx" />
      </files>
    </defaultDocument>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <!-- All project imagery is served as WebP. IIS Express/IIS has no built-in
           mapping for .webp, so without these the files 404. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <!-- No inline <script> in this site, so a strict policy costs nothing.
             The page uses Google Fonts + Material Symbols, both whitelisted. -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
