<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <!-- STAR:DOM database (local development fallback). Change to match your server.
         This value is only the local-dev fallback: Code\Db.vb prefers the
         SUPABASE_DB_URL / POSTGRES_URL, then SUPABASE_URL + SUPABASE_DB_PASSWORD,
         then the DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD environment
         variables, so a deployed host supplies the real credentials from its
         environment and never needs a password committed to source control.

         Code\Db.vb talks PostgreSQL through Npgsql, so this must be an Npgsql
         connection string. Supabase's local/staging values are
             Host=db.<project-ref>.supabase.co;Port=5432;Database=postgres;
             Username=postgres;Password=<db password>;SSL Mode=Require
         Copy the whole string from Supabase -> Project Settings -> Database ->
         Connection string (URI or DSN) into SUPABASE_DB_URL instead, which needs
         no editing here at all. -->
    <add name="STAR_DOM"
         connectionString="Host=localhost;Port=5432;Database=stardom;Username=postgres;Password=postgres;SSL Mode=Disable;Timeout=15;Command Timeout=30;Timezone=Asia/Manila"
         providerName="Npgsql" />
  </connectionStrings>
  <appSettings>
    <add key="AppName" value="STAR:DOM Artisan &amp; Pop-up Hub" />
    <add key="CurrencySymbol" value="₱" />
    <add key="LowStockThreshold" value="5" />
    <add key="Receipt.RegisteredName" value="STAR:DOM Artisan Marketplace &amp; Pop-up Tour" />
    <add key="Receipt.IssuerTin" value="000-000-000-000" />
    <add key="Receipt.IssuerAddress" value="Unit 12, South Luzon Atelier, Santa Rosa, Laguna" />
    <add key="Receipt.AccreditationNo" value="PTU-2026-00015" />
    <add key="Receipt.LineOfBusiness" value="On-line selling of artisan goods &amp; commission services" />

    <!-- Supabase: the publishable/secret keys that used to live here were removed.
         They are credentials and must never be committed to source control, and
         no code reads them today. Read them from the environment instead, the
         same way Code\Db.vb already does for the database:
             Environment.GetEnvironmentVariable("SUPABASE_URL")
             Environment.GetEnvironmentVariable("SUPABASE_PUBLISHABLE_KEY")
             Environment.GetEnvironmentVariable("SUPABASE_SECRET_KEY")
         Set them in the host's environment (Render dashboard, IIS app pool, or
         user-level env var) and reference them from code. The database port is
         fully wired up: Code\Db.vb reads SUPABASE_DB_URL / SUPABASE_URL +
         SUPABASE_DB_PASSWORD and drives Supabase through Npgsql. -->
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" requestValidationMode="2.0" />
    <!-- InProc session holds the signed-in user, so it dies when the app pool recycles.
         That's the one thing to revisit before scaling past a single machine. -->
    <sessionState mode="InProc" timeout="120" />
    <!-- Show the friendly Error.aspx page (which reads the message Global.asax stored
         in Session) instead of leaking stack traces. Detailed errors are still written
         to the AppErrors table by Code\Db.vb.LogError.
         Set customErrors="Off" temporarily while debugging, never on a public host. -->
    <customErrors mode="RemoteOnly" />
    <pages controlRenderingCompatibilityVersion="4.0" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <!-- Session cookie holds the logged-in user: keep it out of reach of page scripts.
         sameSite is deliberately omitted: it is a .NET 4.7.2+ attribute and the
         Linux/Mono (xsp4) deploy in Dockerfile may reject the whole config on it.
         requireSSL is false only because local dev runs on http://localhost — set it
         to true once the site is served over HTTPS. -->
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="App/Marketplace.aspx" />
        <add value="Login.aspx" />
      </files>
    </defaultDocument>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <!-- All project imagery is served as WebP. IIS Express/IIS has no built-in
           mapping for .webp, so without these the files 404. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <!-- No inline <script> in this site, so a strict policy costs nothing.
             The page uses Google Fonts + Material Symbols, both whitelisted. -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <!-- Assembly binding redirects for the Npgsql support stack.
       Npgsql 4.1 plus its transitive dependencies ask for DIFFERENT
       versions of System.Runtime.CompilerServices.Unsafe:
         Npgsql                       wants 4.0.5.0
         System.Memory 4.0.1.2        wants 4.0.4.1
         Tasks.Extensions 4.2.0.1     wants 4.0.4.1
       while bin\ ships a single 6.0.0.0. .NET Framework binds by EXACT version,
       so without a redirect the first page that opens a connection dies with
       "Could not load file or assembly 'System.Runtime.CompilerServices.Unsafe,
       Version=4.0.4.1' ... The located assembly's manifest definition does not
       match the assembly reference" (0x80131040). There is no single version
       that satisfies all three references, so a redirect is the only fix.

       The newVersion values are the versions actually present in bin\, which
       are the ones the project resolved and the image deploys. The
       "oldVersion" ranges are deliberately open-ended and must reach the
       version the REFERENCING assembly actually asks for, which is not always
       the nice round 4.0.0.0: Npgsql 4.1.10's net461 build references
       System.Memory 4.0.1.1 and System.Threading.Tasks.Extensions 4.0.3.0, so
       an oldVersion ceiling of 4.0.0.0 misses them and the request dies with
       0x80131040 on .NET Framework (Mono's loader on Render is laxer and
       masked this). Ranges therefore end at the bin\ versions themselves. -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe"
                          publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory"
                          publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions"
                          publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.0.1" newVersion="4.2.0.1" />
      </dependentAssembly>
      <dependentAssembly>
        <!-- System.Memory 4.0.1.2 depends on System.Numerics.Vectors 4.1.4.0.
             .NET Framework 4.8's GAC only carries 4.0.0.0, so the DLL is
             shipped in bin\ and unified onto it here; without the redirect the
             first connection open fails with FileNotFoundException 4.1.4.0. -->
        <assemblyIdentity name="System.Numerics.Vectors"
                          publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.4.0" newVersion="4.1.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <!-- Same story as System.Numerics.Vectors: System.Memory depends on
             System.Buffers, the GAC does not carry it, so it ships in bin\. -->
        <assemblyIdentity name="System.Buffers"
                          publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
