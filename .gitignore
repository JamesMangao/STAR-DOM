# Visual Studio / MSBuild
.vs/
[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.pidb
*.booproj
UpgradeLog*.htm

# Temporary files
~$*
*.tmp
*.log
.kilocode/

# Admin-uploaded files are runtime artefacts. The QR images themselves now live in
# the database (PaymentSettings.QrImageData), so a pg_dump carries them; only
# pre-migration uploads that were still on disk land here. The directory is
# created on demand, so it never needs to exist in the repo.
STAR-DOM-Web/Uploads/

# Supabase connection details. This file holds the DATABASE PASSWORD and the
# sb_secret_ key -- both are full-credentials and must never be committed, even
# to a private repo. Copy tools/supabase-credentials.example.txt, fill it in
# locally, and it is ignored from then on.
tools/supabase-credentials.txt

# Database dumps. A .dump holds every order plus the QR images, which are the
# real bank account numbers -- it is the whole database in one file. Keep it
# outside the repo.
*.dump
*.backup
tools/backup/

# Packages / output
# The WebForms project root is STAR-DOM-Web/ (it holds the .vbproj, Site.master,
# App/, css/, packages/ and bin/), so these negations must sit at that level --
# a nested STAR-DOM-Web/STAR-DOM-Web/ path does not exist and would silently
# leave the vendored provider DLLs untracked, breaking the Docker build (which
# has no package-restore step).
packages/
!STAR-DOM-Web/packages/
!STAR-DOM-Web/bin/

# The portable PostgreSQL SERVER runtime is committed (tools/pgsql/bin, lib,
# share ~ 119 MB) so a fresh clone can run the site with zero downloads.
# Excluded: pgAdmin 4 / include / symbols (not needed to run the DB), and the
# data directory (tools/pgdata) which start-db.bat initialises on first run.
# Original source if ever needed again:
# https://www.enterprisedb.com/download-postgresql-binaries
tools/pgsql/*
!tools/pgsql/bin/
!tools/pgsql/lib/
!tools/pgsql/share/
tools/pgdata/

# AI tool workspaces
.freebuff/
